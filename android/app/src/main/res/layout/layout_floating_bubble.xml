<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubbleRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/ivBubbleIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_bubble_circle"
        android:elevation="8dp"
        android:padding="6dp"
        android:src="@drawable/kkudok_character_mascot"
        android:contentDescription="해지 가이드 버블" />

    <TextView
        android:id="@+id/tvBubbleBadge"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:elevation="10dp"
        android:background="@drawable/bg_badge_circle"
        android:gravity="center"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />
</FrameLayout>

# 로컬에서는 이 파일을 .env로 복사한 뒤 실제 키를 입력합니다.
# 실제 키가 들어간 .env 파일은 GitHub에 커밋하지 않습니다.

# AI OCR 및 프로모션 비전 분석 (Gemini API 키)
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Supabase 데이터베이스 연동
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 디스코드 신규 프로모션 검수 알림 웹훅 (선택)
# 디스코드 채널 우클릭 > 채널 편집 > 연동 > 웹훅 만들기 > 웹훅 URL 복사
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-token

# 모바일 앱(Capacitor) 빌드 시 배포된 백엔드 API 주소 (웹 배포 시 빈 값 유지)
VITE_API_BASE_URL=


# 공모전 랜딩 전체 시연 영상 공개 URL (선택, 비우면 /assets/contest/kkudok-demo.mp4 사용)
VITE_CONTEST_DEMO_URL=
